# Optional PostgreSQL URL; when set, takes precedence over PM_DATABASE_PATH.
DATABASE_URL=

# Generate a unique random value of at least 32 characters for each deployment.
SESSION_SECRET=
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:8000

# Local SMTP capture is provided by docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=Kanban Studio <no-reply@pm.local>

# Optional. Assigns the first verified matching account as administrator.
BOOTSTRAP_ADMIN_EMAIL=

# Optional OpenRouter API key.
OPENROUTER_API_KEY=
