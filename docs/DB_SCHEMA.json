{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-mvp.local/schemas/board.schema.json",
  "title": "PM MVP board data",
  "description": "Frontend/API representation of one user's Kanban board.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "columns",
    "cards"
  ],
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/column"
      }
    },
    "cards": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "cardIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "cardIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "details"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    }
  }
}
